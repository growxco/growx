# ===========================================================================
# Grow-X — Variáveis de ambiente (copie pra .env.local e preencha)
# O site institucional roda sem integrações. A pré-venda, por segurança, falha
# fechada se DynamoDB ou o provider de pagamento não estiver configurado.
# ===========================================================================

# ============== SERVER-SIDE (Vercel Functions /api/*) ==============
# NUNCA prefixar com VITE_ — essas keys vão pro browser e ficam expostas

# OpenAI API key — usada como fallback ou pra tasks específicas (gpt-4o-mini)
# Console: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API key — usada como modelo principal (Flash é grátis até cota generosa)
# Console: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelos default — pode trocar sem redeploy
AI_CHAT_MODEL=gemini-1.5-flash-latest
AI_FALLBACK_MODEL=gpt-4o-mini

# Rate limiting (defesa contra abuso)
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=200

# Pré-venda do Módulo — server-side, nunca usar prefixo VITE_
# Tabela DynamoDB com PK string `pk`; TTL habilitado no atributo numérico `ttl`.
PREVENDA_SALES_ENABLED=false
PREVENDA_PIX_ENABLED=false
PREVENDA_TURNSTILE_ENABLED=false
PREVENDA_INVENTORY_TABLE=
# Segredo aleatório com no mínimo 32 caracteres para HMAC de CPF/e-mail/IP.
PREVENDA_RESERVATION_SECRET=
# Graça após expiração MP; mínimo aceito 120, default/recomendado 180 minutos.
PREVENDA_MP_SETTLEMENT_GRACE_MINUTES=180
# Autentica /api/cron/reconcile; Vercel Cron envia como Bearer. Mínimo 32 chars.
CRON_SECRET=
AWS_REGION=sa-east-1
# Role exata assumida com token curto da Vercel; não usar access keys estáticas.
AWS_ROLE_ARN=arn:aws:iam::924665350190:role/growx-prevenda-vercel-prod

# Cloudflare Turnstile: secret só no servidor; action/hostname são conferidos.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=prevenda_checkout
TURNSTILE_EXPECTED_HOSTNAMES=growx.com.br,www.growx.com.br

# Pagamentos e confirmações da pré-venda
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
RESEND_API_KEY=
LEAD_INBOX_EMAIL=
PREVENDA_ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# Etapa operacional exibida na área do pedido
LOTE_ETAPA=

# ============== CLIENT-SIDE (vão pro bundle do browser) ==============
# Prefixo VITE_ obrigatório. Tudo aqui é PÚBLICO — não use segredos.

# Analytics
VITE_GA_ID=                   # GA4 (G-XXXXXXX) → analytics.google.com
VITE_META_PIXEL_ID=            # Meta Pixel → business.facebook.com/events_manager
VITE_LINKEDIN_PARTNER_ID=      # LinkedIn Insight → linkedin.com/campaignmanager
VITE_CLARITY_ID=               # Microsoft Clarity → clarity.microsoft.com

# CRM / Forms
VITE_CRM_WEBHOOK_URL=          # Endpoint HTTPS POST JSON (HubSpot/Brevo/n8n/Make/Zapier)
VITE_FORMSUBMIT_EMAIL=growx@growx.com.br  # Fallback sem backend
VITE_CALENDLY_URL=             # https://calendly.com/growx/demo

# Site
VITE_SITE_URL=https://www.growx.com.br

# Feature flags
VITE_AI_ASSISTANT_ENABLED=true # Liga o widget AI no Header (precisa ter GEMINI_API_KEY ou OPENAI_API_KEY no servidor)
VITE_TURNSTILE_SITE_KEY=       # Chave pública do widget da pré-venda
VITE_PREVENDA_PIX_ENABLED=false # Build-time; exige novo deploy para mudar
